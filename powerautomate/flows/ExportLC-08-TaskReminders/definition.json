{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "SiteUrl": {
      "defaultValue": "https://CONTOSO.sharepoint.com/sites/ExportLCPortal",
      "type": "String",
      "metadata": {
        "description": "Portal site collection URL. Set before enabling."
      }
    }
  },
  "triggers": {
    "Daily": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "Arabian Standard Time",
        "schedule": {
          "hours": [
            "7"
          ],
          "minutes": [
            0
          ]
        }
      }
    }
  },
  "actions": {
    "Get_offsets": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "@parameters('SiteUrl')",
          "table": "18_WorkflowConfig",
          "$filter": "Title eq 'TaskDueReminderDays'",
          "$top": 1
        },
        "authentication": "@parameters('$connections')['shared_sharepointonline']['authentication']"
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 5000
        }
      }
    },
    "Get_escalation_days": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "@parameters('SiteUrl')",
          "table": "18_WorkflowConfig",
          "$filter": "Title eq 'OverdueTaskEscalationDays'",
          "$top": 1
        },
        "authentication": "@parameters('$connections')['shared_sharepointonline']['authentication']"
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 5000
        }
      },
      "runAfter": {
        "Get_offsets": [
          "Succeeded"
        ]
      }
    },
    "Parse_offsets": {
      "type": "Compose",
      "inputs": "@split(coalesce(first(body('Get_offsets')?['value'])?['ConfigValue'], '3;1;0'), ';')",
      "runAfter": {
        "Get_escalation_days": [
          "Succeeded"
        ]
      }
    },
    "Apply_to_each_offset": {
      "type": "Foreach",
      "foreach": "@outputs('Parse_offsets')",
      "runAfter": {
        "Parse_offsets": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "actions": {
        "Target_date": {
          "type": "Compose",
          "inputs": "@{formatDateTime(addDays(utcNow(), int(trim(items('Apply_to_each_offset')))), 'yyyy-MM-dd')}"
        },
        "Get_tasks_due": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('SiteUrl')",
              "table": "09_Tasks",
              "$filter": "IsOpen eq 1 and DueDate ge '@{outputs('Target_date')}T00:00:00Z' and DueDate le '@{outputs('Target_date')}T23:59:59Z'",
              "$top": 500
            },
            "authentication": "@parameters('$connections')['shared_sharepointonline']['authentication']"
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 5000
            }
          },
          "runAfter": {
            "Target_date": [
              "Succeeded"
            ]
          }
        },
        "Apply_to_each_task": {
          "type": "Foreach",
          "foreach": "@body('Get_tasks_due')?['value']",
          "runAfter": {
            "Get_tasks_due": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 8
            }
          },
          "actions": {
            "Notification_key": {
              "type": "Compose",
              "inputs": "@{concat('ExportLC-08-TaskReminders:', string(items('Apply_to_each_task')?['ID']), ':', trim(items('Apply_to_each_offset')))}"
            },
            "Check_already_sent": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('SiteUrl')",
                  "table": "26_NotificationLog",
                  "$filter": "Title eq '@{outputs('Notification_key')}'",
                  "$top": 1
                },
                "authentication": "@parameters('$connections')['shared_sharepointonline']['authentication']"
              },
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 5000
                }
              },
              "runAfter": {
                "Notification_key": [
                  "Succeeded"
                ]
              }
            },
            "If_not_sent": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@length(body('Check_already_sent')?['value'])",
                      0
                    ]
                  },
                  {
                    "not": {
                      "equals": [
                        "@coalesce(items('Apply_to_each_task')?['AssignedToEmail'], '')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "runAfter": {
                "Check_already_sent": [
                  "Succeeded"
                ]
              },
              "actions": {
                "Send_task_reminder": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@{items('Apply_to_each_task')?['AssignedToEmail']}",
                      "emailMessage/Subject": "@{if(equals(int(trim(items('Apply_to_each_offset'))),0),'Due today','Due in ')}@{if(equals(int(trim(items('Apply_to_each_offset'))),0),'',concat(trim(items('Apply_to_each_offset')),' day(s)'))}: @{items('Apply_to_each_task')?['Title']}",
                      "emailMessage/Body": "<p><strong>@{items('Apply_to_each_task')?['Title']}</strong></p><p>LC: @{coalesce(items('Apply_to_each_task')?['LCNumber'], 'not linked')}<br/>Priority: @{items('Apply_to_each_task')?['Priority']}<br/>Due: @{formatDateTime(items('Apply_to_each_task')?['DueDate'],'dd MMM yyyy')}</p><p>@{coalesce(items('Apply_to_each_task')?['TaskDescription'], '')}</p>",
                      "emailMessage/Importance": "@{if(equals(items('Apply_to_each_task')?['Priority'],'Critical'),'High','Normal')}"
                    },
                    "authentication": "@parameters('$connections')['shared_office365']['authentication']"
                  }
                },
                "Update_reminder_count": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('SiteUrl')",
                      "table": "09_Tasks",
                      "id": "@{items('Apply_to_each_task')?['ID']}",
                      "item": {
                        "ReminderSentCount": "@{add(coalesce(items('Apply_to_each_task')?['ReminderSentCount'], 0), 1)}",
                        "LastReminderDate": "@{utcNow()}"
                      }
                    },
                    "authentication": "@parameters('$connections')['shared_sharepointonline']['authentication']"
                  },
                  "runAfter": {
                    "Send_task_reminder": [
                      "Succeeded"
                    ]
                  }
                },
                "Log_notification": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PostItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('SiteUrl')",
                      "table": "26_NotificationLog",
                      "item": {
                        "Title": "@{outputs('Notification_key')}",
                        "RuleCode": "ExportLC-08-TaskReminders",
                        "EntityName": "09_Tasks",
                        "RecordReference": "@{items('Apply_to_each_task')?['Title']}",
                        "InternalLCID": "@{coalesce(items('Apply_to_each_task')?['InternalLCID'], '')}",
                        "RecipientEmail": "@{items('Apply_to_each_task')?['AssignedToEmail']}",
                        "OffsetDays": "@{int(trim(items('Apply_to_each_offset')))}",
                        "SentTimestamp": "@{utcNow()}",
                        "SendStatus": "Sent",
                        "PartitionKey": "@{formatDateTime(utcNow(), 'yyyy-MM')}"
                      }
                    },
                    "authentication": "@parameters('$connections')['shared_sharepointonline']['authentication']"
                  },
                  "runAfter": {
                    "Update_reminder_count": [
                      "Succeeded",
                      "Failed"
                    ]
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          }
        }
      }
    },
    "Mark_overdue_proceeds": {
      "type": "Scope",
      "runAfter": {
        "Apply_to_each_offset": [
          "Succeeded"
        ]
      },
      "actions": {
        "Get_matured_unpaid": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('SiteUrl')",
              "table": "07_Proceeds",
              "$filter": "IsSettled eq 0 and MaturityDate lt '@{formatDateTime(utcNow(),'yyyy-MM-dd')}T00:00:00Z' and ProceedsStatus ne 'Overdue' and ProceedsStatus ne 'Written Off'",
              "$top": 500
            },
            "authentication": "@parameters('$connections')['shared_sharepointonline']['authentication']"
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 5000
            }
          }
        },
        "Apply_to_each_proceeds": {
          "type": "Foreach",
          "foreach": "@body('Get_matured_unpaid')?['value']",
          "runAfter": {
            "Get_matured_unpaid": [
              "Succeeded"
            ]
          },
          "actions": {
            "Set_overdue": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('SiteUrl')",
                  "table": "07_Proceeds",
                  "id": "@{items('Apply_to_each_proceeds')?['ID']}",
                  "item": {
                    "ProceedsStatus": "Overdue"
                  }
                },
                "authentication": "@parameters('$connections')['shared_sharepointonline']['authentication']"
              }
            }
          }
        }
      },
      "metadata": {
        "comment": "A status that only changes when someone opens the record is a status nobody can filter on. This sweep is what makes the Overdue preset trustworthy."
      }
    },
    "Mark_overdue_invoices": {
      "type": "Scope",
      "runAfter": {
        "Mark_overdue_proceeds": [
          "Succeeded"
        ]
      },
      "actions": {
        "Get_past_due_invoices": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('SiteUrl')",
              "table": "03_Invoices",
              "$filter": "IsSettled eq 0 and DueDate lt '@{formatDateTime(utcNow(),'yyyy-MM-dd')}T00:00:00Z' and InvoiceStatus ne 'Overdue' and InvoiceStatus ne 'Cancelled'",
              "$top": 500
            },
            "authentication": "@parameters('$connections')['shared_sharepointonline']['authentication']"
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 5000
            }
          }
        },
        "Apply_to_each_invoice": {
          "type": "Foreach",
          "foreach": "@body('Get_past_due_invoices')?['value']",
          "runAfter": {
            "Get_past_due_invoices": [
              "Succeeded"
            ]
          },
          "actions": {
            "Set_invoice_overdue": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('SiteUrl')",
                  "table": "03_Invoices",
                  "id": "@{items('Apply_to_each_invoice')?['ID']}",
                  "item": {
                    "InvoiceStatus": "Overdue"
                  }
                },
                "authentication": "@parameters('$connections')['shared_sharepointonline']['authentication']"
              }
            }
          }
        }
      }
    }
  },
  "outputs": {}
}